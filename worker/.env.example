# --- Tweezgroup LinkedIn sourcing worker ---
# Recommended: app on Render, worker on your PC (headed Chromium + LinkedIn login).
APP_URL=https://jobs.tweezgroup.com
# Must match Render dashboard → your web service → Environment → API_KEY
API_KEY=paste-the-API_KEY-from-Render-environment
# Folder where the logged-in Chromium profile is kept (created by `python -m worker login`)
LINKEDIN_PROFILE_DIR=./linkedin-profile
HEADLESS=0
POLL_SECONDS=45
INBOX_EVERY_MINUTES=30
MAX_ACTIONS_PER_PASS=8
BROWSER_LOCALE=fr-FR
BROWSER_TZ=Europe/Paris
