# --- core ---
SECRET_KEY=change-me                # run: flask --app wsgi rotate-keys
COMPANY_NAME=Tweezgroup
PUBLIC_BASE_URL=https://jobs.tweezgroup.com
PRIVACY_CONTACT_EMAIL=hr@tweezgroup.com

# --- database: SQLite (default) or MySQL ---
# DATABASE_URL=sqlite:///data/applicants.db
# DATABASE_URL=mysql+pymysql://user:password@host:3306/applicants

# --- auth ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
API_KEY=change-me                   # sent by the agent as X-API-Key

# --- CV storage: gdrive (TWEEZ-CV-BANK) | s3 | local ---
STORAGE_BACKEND=gdrive
GDRIVE_ROOT_FOLDER_ID=13CFAOjtqDm8KotvrTo__ujWkYhdYM-zI
# Option A (recommended): OAuth token of the Drive owner — run `python scripts/gdrive_auth.py`
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Option B: service account JSON with domain-wide delegation, acting as the Drive owner
# GOOGLE_SERVICE_ACCOUNT_JSON=/srv/sa.json
# GOOGLE_IMPERSONATE_USER=mehdi@tweezgroup.com
# S3 alternative (Supabase Storage / DO Spaces / R2):
# STORAGE_BACKEND=s3  S3_BUCKET=cvs  S3_REGION=eu-central-1  S3_ENDPOINT_URL=...  S3_ACCESS_KEY=  S3_SECRET_KEY=  S3_ADDRESSING_STYLE=path
MAX_UPLOAD_MB=10

# --- CV auto-summary (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
SUMMARY_MODEL=claude-haiku-4-5

# --- ClickUp ---
CLICKUP_API_TOKEN=                    # personal token from ClickUp Settings → Apps (starts with pk_)
CLICKUP_LIST_ID=                    # default list; each role can override with its own list id
CLICKUP_ENABLED=true
CLICKUP_CREATE_ON=apply             # apply = a task for every application | filtered = only once filtered in
CLICKUP_TEAM_ID=9015802184
CLICKUP_ASSIGNEE=Mehdi Mahcene
CLICKUP_MENTIONS=Ahmidou, Taoufik Mousselmal, Abderrahmane Hammia

# --- automatic status from CV score ---
AUTO_STATUS_ENABLED=true
REJECT_BELOW=50                     # score below 50 -> REJECTED
SELECT_ABOVE=60                     # 50-60 -> FILTRED APPLICATION; above 60 -> SELECTED (or TEST SENT if the role has a test)

# --- candidate email (test invitations) ---
# Production (Render): use Gmail API. Render cannot reach smtp.gmail.com (Errno 101).
# Re-run scripts/gdrive_auth.py so the token covers gmail.send; enable the Gmail API.
MAIL_BACKEND=gmail_api
# Optional SMTP (local only). Leave empty on Render.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=hr@tweezgroup.com

# --- ClickUp two-way sync: fully automatic (webhook self-registers + polling fallback) ---
CLICKUP_WEBHOOK_AUTOREGISTER=true
CLICKUP_POLL_MINUTES=10

# --- GDPR ---
RETENTION_MONTHS=12
